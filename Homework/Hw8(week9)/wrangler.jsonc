{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myshop",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myshop-db",
      "database_id": "5d156f51-de0e-48b4-b4d8-deb2798e8fab"
    }
  ]
}
